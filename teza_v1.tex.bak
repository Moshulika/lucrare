      \noindent
      \begin{minipage}[c]{0.48\textwidth}
        \includegraphics*[width=\columnwidth]{figuri/vibeweb1.png}
        \includegraphics*[width=\columnwidth]{figuri/vibeweb2.png}
        \includegraphics*[width=\columnwidth]{figuri/vibeweb3.png}
      \end{minipage}\hfill
