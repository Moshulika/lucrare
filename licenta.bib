@misc{liuAgenticCriticalTraining2026,
  title = {Agentic {{Critical Training}}},
  author = {Liu, Weize and Liu, Minghui and Ho, Sy-Tuyen and Chakraborty, Souradip and Wang, Xiyao and Huang, Furong},
  year = 2026,
  month = mar,
  number = {arXiv:2603.08706},
