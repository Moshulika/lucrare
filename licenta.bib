@misc{luAdvancingAutomatedAlgorithm2026,
  title = {Advancing {{Automated Algorithm Design}} via {{Evolutionary Stagewise Design}} with {{LLMs}}},
  author = {Lu, Chen and Xue, Ke and Gao, Chengrui and Shi, Yunqi and Xu, Siyuan and Yuan, Mingxuan and Qian, Chao and Zhou, Zhi-Hua},
  year = 2026,
