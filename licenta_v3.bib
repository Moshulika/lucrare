	keywords = {Computer Science - Artificial Intelligence, Computer Science - Data Structures and Algorithms, Computer Science - Databases, Computer Science - Machine Learning},
	file = {Full Text PDF:/Users/enanescu/Zotero/storage/9LY756H2/Zandieh et al. - 2025 - TurboQuant Online Vector Quantization with Near-optimal Distortion Rate.pdf:application/pdf;Snapshot:/Users/enanescu/Zotero/storage/FGRCVM4S/2504.html:text/html},
