	file = {Preprint PDF:/Users/enanescu/Zotero/storage/AFRCVGZS/Tian and Liu - 2026 - Shorter Thoughts, Same Answers Difficulty-Scaled Segment-Wise RL for CoT Compression.pdf:application/pdf;Snapshot:/Users/enanescu/Zotero/storage/D2UP6UAP/2603.html:text/html},
