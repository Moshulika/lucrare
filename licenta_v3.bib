	shortjournal = {Artif Intell Rev},
	author = {Dong, Yi and Mu, Ronghui and Zhang, Yanghao and Sun, Siqi and Zhang, Tianle and Wu, Changshun and Jin, Gaojie and Qi, Yi and Hu, Jinwei and Meng, Jie and Bensalem, Saddek and Huang, Xiaowei},
	urldate = {2026-03-10},
	date = {2025-10-17},
	langid = {english},
	keywords = {Generative {AI}, Guardrails, Large language models, Safeguards, Trustworthy {AI}},
	file = {Full Text PDF:/Users/enanescu/Zotero/storage/74V9LBXW/Dong et al. - 2025 - Safeguarding large language models a survey.pdf:application/pdf},
