@article{alaharjuEnsuringPerformanceReliability2024,
	title = {Ensuring Performance and Reliability in {LLM}-Based Applications: A Case Study},
	url = {https://aaltodoc.aalto.fi/handle/123456789/133914},
	shorttitle = {Ensuring Performance and Reliability in {LLM}-Based Applications},
	abstract = {In this case study I sought to explore how developing proper solutions that leverage large language models ({LLMs}) should be developed and how the gap from a Proof-of-Concept to a proper product can be closed. The product of development investigated is an {LLM}-based tool designed to automatically assess the compliance status of companies against a set of requirements. I adopt a performance insurance perspective, tackling the challenges that arise from the use of black-box foundation models, mainly the uncertainty and explainability of outputs. I find an importance of balancing foundational {LLM} performance with design approaches that secure trust in the solution. A key finding is that developers have levers for controlling both the performance of {LLM}-based systems, as well as the performance requirements. Performance can be improved, for instance, through providing better context or prompt engineering, whereas strategically placing human oversight into the process or using other trust insurance practices allows closing the gap between imperfect or uncertain performance and practical usefulness without causing unbearable effort to human validators. I highlight the use of these levers in the case study. The solution was recognized valuable by compliance professionals as an aid in accelerating the gap analysis process. To ensure reliability and maintain the integrity of the compliance process, structured testing and detailed validation of results were conducted. The main takeaway of performance testing was that it was not good enough to work fully autonomously, but the analysis was still good enough to provide value in a human-in-the-loop way. As a result, the tool's usage was designed to leverage established best practices in the compliance domain and strategic human involvement addressing the remaining uncertainty. I shifted the focus in testing to a co-auditing perspective, focusing things like ease of error detection. One of the key features of the use-case was that it provided value already in the human-in-the-loop version, allowing for iterative improvements while creating value, providing an incremental path to autonomy.},
	author = {Alaharju, Henri},
	urldate = {2026-03-10},
	date = {2024-12-23},
	langid = {english},
	file = {Full Text PDF:/Users/enanescu/Zotero/storage/7TIEQV2N/Alaharju - 2024 - Ensuring Performance and Reliability in LLM-Based Applications A Case Study.pdf:application/pdf},
}

@article{sergeyukUsingAIbasedCoding2025,
	title = {Using {AI}-based coding assistants in practice: State of affairs, perceptions, and ways forward},
	volume = {178},
	issn = {0950-5849},
	url = {https://www.sciencedirect.com/science/article/pii/S0950584924002155},
	doi = {10.1016/j.infsof.2024.107610},
	shorttitle = {Using {AI}-based coding assistants in practice},
	abstract = {Context:
The last several years saw the emergence of {AI} assistants for code — multi-purpose {AI}-based helpers in software engineering. As they become omnipresent in all aspects of software development, it becomes critical to understand their usage patterns.
Objective:
We aim to better understand how specifically developers are using {AI} assistants, why they are not using them in certain parts of their development workflow, and what needs to be improved in the future.
Methods:
In this work, we carried out a large-scale survey aimed at how {AI} assistants are used, focusing on specific software development activities and stages. We collected opinions of 481 programmers on five broad activities: (a) implementing new features, (b) writing tests, (c) bug triaging, (d) refactoring, and (e) writing natural-language artifacts, as well as their individual stages.
Results:
Our results provide a novel comparison of different stages where {AI} assistants are used that is both comprehensive and detailed. It highlights specific activities that developers find less enjoyable and want to delegate to an {AI} assistant, e.g., writing tests and natural-language artifacts. We also determine more granular stages where {AI} assistants are used, such as generating tests and generating docstrings, as well as less studied parts of the workflow, such as generating test data. Among the reasons for not using assistants, there are general aspects like trust and company policies, as well as more concrete issues like the lack of project-size context, which can be the focus of the future research.
Conclusion:
The provided analysis highlights stages of software development that developers want to delegate and that are already popular for using {AI} assistants, which can be a good focus for features aimed to help developers right now. The main reasons for not using {AI} assistants can serve as a guideline for future work.},
	pages = {107610},
	journaltitle = {Information and Software Technology},
	shortjournal = {Information and Software Technology},
	author = {Sergeyuk, Agnia and Golubev, Yaroslav and Bryksin, Timofey and Ahmed, Iftekhar},
	urldate = {2026-03-10},
	date = {2025-02-01},
	keywords = {{AI} assistants, {LLMs}, Software development lifecycle},
}

@inproceedings{tangCodeAgentAutonomousCommunicative2024,
	location = {Miami, Florida, {USA}},
	title = {{CodeAgent}: Autonomous Communicative Agents for Code Review},
	url = {https://aclanthology.org/2024.emnlp-main.632/},
	doi = {10.18653/v1/2024.emnlp-main.632},
	shorttitle = {{CodeAgent}},
	abstract = {Code review, which aims at ensuring the overall quality and reliability of software, is a cornerstone of software development. Unfortunately, while crucial, Code review is a labor-intensive process that the research community is looking to automate. Existing automated methods rely on single input-output generative models and thus generally struggle to emulate the collaborative nature of code review. This work introduces {CodeAgent}, a novel multi-agent Large Language Model ({LLM}) system for code review automation. {CodeAgent} incorporates a supervisory agent, {QA}-Checker, to ensure that all the agents' contributions address the initial review question. We evaluated {CodeAgent} on critical code review tasks: (1) detect inconsistencies between code changes and commit messages, (2) identify vulnerability introductions, (3) validate code style adherence, and (4) suggest code revisions. The results demonstrate {CodeAgent}'s effectiveness, contributing to a new state-of-the-art in code review automation. Our data and code are publicly available (https://github.com/Daniel4SE/codeagent).},
	eventtitle = {{EMNLP} 2024},
	pages = {11279--11313},
	booktitle = {Proceedings of the 2024 Conference on Empirical Methods in Natural Language Processing},
	publisher = {Association for Computational Linguistics},
